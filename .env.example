# ── Sentinel .env.example ────────────────────────────────────────────────────
# Skopiuj: cp .env.example .env   → uzupełnij swoje klucze

# Django
DJANGO_SECRET_KEY=zmien-na-losowy-klucz-min-50-znakow
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,sentinel.local

# SQLite path (Docker volume na Pi)
DB_PATH=/app/db/db.sqlite3

# Redis
REDIS_URL=redis://redis:6379/0

# Binance Futures
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=True
BINANCE_WS_URL=wss://fstream.binance.com
BINANCE_REST_URL=https://fapi.binance.com

# AI providers. Auction Intelligence uses OpenAI by default.
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=

# Trading
TRADING_PAIRS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT
GLOBAL_CONTEXT_PAIRS=BTCUSDT,ETHUSDT
TRADING_MODE=paper
MAX_RISK_PER_TRADE=0.002
MAX_DAILY_DRAWDOWN=0.006
MAX_DAILY_PORTFOLIO_DRAWDOWN=0.006
MAX_WEEKLY_DRAWDOWN=0.018
MAX_OPEN_POSITIONS=2
MAX_LEVERAGE=5
INITIAL_BALANCE=10000
PROFIT_TO_SPOT_RATIO=0.10
LIVE_CAPITAL_BASELINE_USD=10000

# Auction Intelligence — tylko shadow, bez uprawnienia do składania zleceń
AUCTION_SHADOW_ENABLED=True
AUCTION_SHADOW_AI_ENABLED=True
# Lista aktywnych pluginow. Usuniecie ID blokuje nowe plany, ale zachowuje
# plugin do rozstrzygania otwartych planow i odtwarzania historii.
AUCTION_ENABLED_STRATEGIES=SAI1_FAILED_AUCTION,SAI1_IFVG_FLIP,SAI1_TREND_RETEST
AUCTION_AI_PROVIDER=openai
AUCTION_OPENAI_MODEL=gpt-6.1-sol
AUCTION_OPENAI_REASONING_EFFORT=high
AUCTION_OPENAI_INPUT_USD_PER_MILLION=2.0
AUCTION_OPENAI_CACHED_INPUT_USD_PER_MILLION=0.10
AUCTION_OPENAI_OUTPUT_USD_PER_MILLION=10.0
AUCTION_OPENAI_PRICING_AS_OF=2026-10-26
AUCTION_AI_DAILY_BUDGET_USD=1.0

# Telegram: create a bot with @BotFather, put its token here, send /start to
# the bot and copy the chat id it replies with.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_STATUSES=WAIT_RETEST,WAIT_MSS
FEED_STALE_SECONDS=300
SETUP_SEARCH_ENABLED=True
SETUP_SEARCH_MAX_SYMBOLS=60
AUCTION_SHADOW_TARGET_R=1.5
AUCTION_SHADOW_MAX_HOLD_MINUTES=240
AUCTION_SHADOW_CYCLE_SECONDS=300
AUCTION_SHADOW_RESOLVE_SECONDS=60
ORDER_BOOK_STREAM_ENABLED=True
ORDER_BOOK_SNAPSHOT_INTERVAL_SECONDS=5
ORDER_BOOK_RETENTION_DAYS=14
AGGTRADE_RETENTION_DAYS=14
OPEN_INTEREST_POLL_SECONDS=300
AGGTRADE_FLUSH_SECONDS=1
PAPER_MARKET_SLIPPAGE_BPS=5
PAPER_ALT_SLIPPAGE_BPS=15
PAPER_TAKER_FEE_BPS=5
PAPER_MAKER_FEE_BPS=2
PAPER_STOP_MANAGEMENT_POLICY=INITIAL_STOP_ONLY

# Live exchange
EXCHANGE_NAME=kucoin
LIVE_TRADING_ENABLED=False
KUCOIN_API_KEY=replace-me
KUCOIN_API_SECRET=replace-me
KUCOIN_API_PASSPHRASE=replace-me
KUCOIN_FUTURES_REST_URL=https://api-futures.kucoin.com
KUCOIN_FUTURES_WS_URL=wss://wsapi-futures.kucoin.com
# TP=last trade price (documented KuCoin default used by Sentinel). Live entry
# remains hard-blocked in code until test-subaccount validation is complete.
KUCOIN_STOP_PRICE_TYPE=TP

# Frontend — puste = działa przez nginx (zalecane dla Pi)
VITE_API_URL=
